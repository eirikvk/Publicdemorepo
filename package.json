{
  "name": "naturregnskap-demo",
  "private": true,
  "type": "module",
  "description": "Kommunalt naturregnskap, teknologidemo. React med Miljødirektoratets designsystem, bygget med Vite.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "bygg": "vite build",
    "forhandsvis": "vite preview",
    "formater": "prettier --write src verktoy/*.js verktoy/*.ts",
    "sjekk-format": "prettier --check src verktoy/*.js verktoy/*.ts",
    "test": "node verktoy/regresjon.js ut/ny",
    "sjekk": "tsc -p . && tsc -p verktoy && node verktoy/sjekk-lag.ts"
  },
  "dependencies": {
    "@fontsource/open-sans": "5.2.7",
    "@miljodirektoratet/md-css": "6.32.0",
    "@miljodirektoratet/md-react": "6.35.0",
    "ol": "10.6.1",
    "polygon-clipping": "0.15.7",
    "proj4": "2.11.0",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/proj4": "2.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxc-parser": "0.151.0",
    "playwright": "1.56.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
