    "proj4": "2.11.0",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "acorn": "8.19.0",
    "acorn-jsx": "5.3.2",
    "acorn-walk": "8.3.5",
    "eslint-scope": "9.1.2",
