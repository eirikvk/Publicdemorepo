{
  "name": "naturregnskap-demo",
  "private": true,
  "type": "module",
  "description": "Kommunalt naturregnskap, teknologidemo. React med Miljødirektoratets designsystem, bygget med Vite.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "dev-figma": "vite -c vite.figma.config.ts",
    "dev-parquet": "vite -c vite.parquet.config.ts",
    "bygg": "vite build",
    "bygg-figma": "vite build -c vite.figma.config.ts",
    "bygg-parquet": "vite build -c vite.parquet.config.ts",
    "forhandsvis": "vite preview",
    "formater": "prettier --write src srcFigma srcParquet verktoy/*.ts test vite.config.ts vite.figma.config.ts vite.parquet.config.ts",
    "sjekk-format": "prettier --check src srcFigma srcParquet verktoy/*.ts test vite.config.ts vite.figma.config.ts vite.parquet.config.ts",
    "test": "node --test test/*.test.ts",
    "regresjon": "node verktoy/regresjon.ts ut/ny",
    "roykt-figma": "node verktoy/figma-roykt.ts",
    "utgave": "node verktoy/utgave.ts",
    "klasser": "node verktoy/klasser.ts",
    "forklaringer": "node verktoy/forklaringer.ts",
    "sjekk": "tsc -p . && tsc -p verktoy && node verktoy/sjekk-lag.ts && node verktoy/forklaringer.ts --sjekk"
  },
  "dependencies": {
    "@fontsource/open-sans": "5.2.7",
    "@miljodirektoratet/md-css": "6.32.0",
    "@miljodirektoratet/md-react": "6.35.0",
    "hyparquet": "1.31.2",
    "ol": "10.6.1",
    "polygon-clipping": "0.15.7",
    "proj4": "2.11.0",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxc-parser": "0.151.0",
    "playwright": "1.56.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
